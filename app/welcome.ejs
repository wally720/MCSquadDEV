<div id="welcomeContainer" class="sai-intro" style="display: none;" data-squad-arcade-intro>
    <audio data-sai-audio data-src="assets/audio/intro-tormenta-arcade.wav"></audio>
    <div class="sai-backdrop" aria-hidden="true">
        <div class="sai-sky sai-sky-a"></div>
        <div class="sai-sky sai-sky-b"></div>
        <div class="sai-vignette"></div>
    </div>

    <button class="sai-skip" type="button" data-sai-skip>SALTAR ESTA VEZ</button>

    <main class="sai-lockup" aria-labelledby="saiTitle">
        <div class="sai-stage" aria-hidden="true">
            <div class="sai-storm">
                <span class="sai-storm-ring sai-storm-ring-a"></span>
                <span class="sai-storm-ring sai-storm-ring-b"></span>
                <span class="sai-storm-ring sai-storm-ring-c"></span>
                <% for(let i = 0; i < 6; i++){ %>
                    <span class="sai-convergence sai-convergence-<%= i + 1 %>"></span>
                <% } %>
            </div>

            <svg class="sai-lightning" viewBox="0 0 980 530" preserveAspectRatio="none">
                <path d="M0 42 L154 128 L112 176 L330 246 L450 265"/>
                <path d="M980 48 L823 122 L860 181 L644 237 L530 265"/>
                <path d="M0 490 L160 400 L121 353 L342 286 L455 265"/>
                <path d="M980 486 L814 404 L854 344 L641 289 L525 265"/>
            </svg>

            <div class="sai-portal">
                <span class="sai-portal-ring sai-portal-ring-a"></span>
                <span class="sai-portal-ring sai-portal-ring-b"></span>
            </div>

            <div class="sai-fragments">
                <% for(let i = 0; i < 8; i++){ %>
                    <span class="sai-fragment-position sai-fragment-position-<%= i + 1 %>">
                        <i class="sai-fragment"></i>
                    </span>
                <% } %>
            </div>

            <span class="sai-impact"></span>
            <span class="sai-impact-line"></span>
        </div>

        <div class="sai-seal-wrap" data-sai-logo>
            <span class="sai-seal-halo"></span>
            <img class="sai-seal" src="assets/images/SealCircle.png" alt="MCSquad Arcade emblem">
        </div>
        <div class="sai-copy">
            <p class="sai-eyebrow">TORRE DE INVOCACION // ENLACE ESTABLE</p>
            <h1 id="saiTitle">MCSQUAD <span>ARCADE</span></h1>
            <p class="sai-tagline">CUATRO MUNDOS. UNA SQUAD.</p>
        </div>
        <div class="sai-actions">
            <p class="sai-runtime-status sai-final-control" data-sai-status>PREPARANDO LAUNCHER...</p>
            <button id="welcomeButton" class="sai-continue sai-final-control" type="button" data-sai-continue disabled>
                <span class="sai-continue-label">CONTINUAR</span>
                <span class="sai-continue-arrow" aria-hidden="true">&#9654;</span>
            </button>
        </div>
    </main>

    <label class="sai-opt-out" hidden>
        <input type="checkbox" data-sai-opt-out>
        <span>No volver a mostrar esta introducción</span>
    </label>
    <p class="sai-live" aria-live="polite" aria-atomic="true" data-sai-live></p>
    <script src="./assets/js/scripts/welcome.js"></script>
</div>
